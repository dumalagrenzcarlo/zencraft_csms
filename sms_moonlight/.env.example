APP_NAME="ZenCraft CSMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8089
APP_DOMAIN=localhost

PLATFORM_DOMAIN=localhost
TENANT_BASE_DOMAIN=localhost
SAAS_TRIAL_DAYS=30

PLATFORM_OWNER_NAME="Platform Owner"
PLATFORM_OWNER_EMAIL=owner@example.test
PLATFORM_OWNER_PASSWORD=

SCHOOL_BASE_DOMAIN=
SCHOOL_TIMEZONE=Asia/Manila
ADMIN_PORTAL_DOMAIN=
TEACHER_PORTAL_DOMAIN=
STUDENT_PORTAL_DOMAIN=

QUIZ_MODULE_ENABLED=false
COLLEGE_MODULE_ENABLED=true
PAYMENTS_MODULE_ENABLED=true
STAFF_MODULE_ENABLED=true
TEACHER_STAFF_ATTENDANCE_ENABLED=true
EASTER_EGGS_ENABLED=true
PAYMENTS_ADMIN_USERNAME=admin
PAYMENTS_UNLOCK_MINUTES=15
SAAS_BILLING_GRACE_DAYS=7
SAAS_SUPPORT_ACCESS_MINUTES=60
SAAS_BACKUP_DISK=local
SAAS_FREE_TENANT_DB_CONNECTION=tenant_sqlite

SCHOOL_THEME_PRIMARY="#F7BC3B"
SCHOOL_THEME_SECONDARY="#D97706"
SCHOOL_THEME_BACKGROUND="#F8F1E5"
SCHOOL_THEME_TEXT="#454548"
SCHOOL_THEME_ACCENT="#38BDF8"
SCHOOL_THEME_ALERT="#E94560"
SCHOOL_THEME_SURFACE="#FFFFFF"
SCHOOL_THEME_DARK_BACKGROUND="#1F2937"
SCHOOL_THEME_DARK_TEXT="#E5E7EB"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Opt-in local/staging MySQL dummy administrator. Run explicitly with:
# php artisan db:seed --class=DummyAdminSeeder
DUMMY_ADMIN_ENABLED=false
DUMMY_ADMIN_NAME="Dummy Admin (Local/Staging Only)"
DUMMY_ADMIN_EMAIL=dummy.admin@example.test
DUMMY_ADMIN_USERNAME=dummy-admin
DUMMY_ADMIN_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_UPLOADS_ROOT=
PUBLIC_UPLOADS_URL=
PUBLIC_UPLOADS_USE_STORAGE_LINK=false
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
