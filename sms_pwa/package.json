{
  "name": "sms-scanner",
  "version": "1.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild:native",
    "test": "node --test test/*.test.js",
    "pack": "electron-packager . sms-attendance-scanner --platform=win32 --arch=x64 --out=dist --icon=./src/assets/icons/icon.ico --ignore=\"^/test($|/)\" --overwrite",
    "dist": "electron-builder",
    "build:css": "tailwindcss -i ./src/styles.css -o ./src/assets/tailwind.css --watch"
  },
  "build": {
    "appId": "com.academy.sms-scanner",
    "productName": "SMS Attendance Scanner",
    "executableName": "SMS Attendance Scanner",
    "win": {
      "icon": "./src/assets/icons/icon.ico",
      "target": "nsis"
    },
    "mac": {
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./src/assets/icons/icon.ico",
      "uninstallerIcon": "./src/assets/icons/icon.ico",
      "installerHeaderIcon": "./src/assets/icons/icon.ico",
      "shortcutName": "SMS Attendance Scanner",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "packElevateHelper": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/sms-attendance-scanner"
      }
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "electron": "^30.5.1",
    "electron-builder": "^24.0.0",
    "electron-packager": "^17.1.2",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.8.9"
  },
  "description": "An attendance scanner for recording student and staff attendance.",
  "keywords": [
    "attendance",
    "scanner",
    "school"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
